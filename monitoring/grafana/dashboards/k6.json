          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Duracion del tick en el servidor",
      "description": "Metrica del backend (Micrometer). Hay un tick cada 66 ms: mientras este muy por debajo, hay holgura.",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
